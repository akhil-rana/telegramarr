# Development Dockerfile - builds and runs everything in container
# Use for testing the complete build + run process in isolation
# Includes all build tools (Node.js, Go, etc.) and runs the application

FROM golang:1.25-alpine AS base

# Install build dependencies
# Note: We need libc6-compat for the dynamically linked RAR binaries
RUN apk add --no-cache \
    git \
    make \
    gcc \
    musl-dev \
    curl \
    tar \
    nodejs \
    npm \
    p7zip \
    ca-certificates \
    tzdata \
    tini \
    libc6-compat

# Download and install RAR tools during build
# Note: Archive contains rar/ folder with binaries inside
# Extract rar folder, copy binaries from inside, and clean up
RUN curl -LsSf https://www.rarlab.com/rar/rarlinux-x64-720.tar.gz > /tmp/rarlinux.tar.gz && \
    tar xf /tmp/rarlinux.tar.gz -C /tmp && \
    install -v -m755 /tmp/rar/unrar /usr/local/bin && \
    install -v -m755 /tmp/rar/rar /usr/local/bin && \
    rm -rf /tmp/rarlinux.tar.gz /tmp/rar && \
    which unrar && which rar && \
    unrar 2>&1 | head -3 && \
    rar 2>&1 | head -3

WORKDIR /app

# Copy entire source code
COPY . .

# Build React frontend
RUN echo "Building React frontend..." && \
    cd src/ui && \
    npm install && \
    npm run build && \
    cd /app && \
    echo "Frontend build complete"

# Build Go binary (go.mod is in src/ directory)
RUN echo "Building Go binary..." && \
    cd src && \
    CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-s -w" \
    -o ../telegramarr \
    ./cmd/telegramarr && \
    cd /app && \
    echo "Go binary build complete"

# Verify builds
RUN echo "Verifying builds..." && \
    ls -lh telegramarr && \
    ls -la src/ui/dist/ && \
    [ -x ./telegramarr ] && echo "Binary is executable" && \
    echo "Build verification complete"

# Create non-root user for security
RUN addgroup -g 1000 -S telegramarr && \
    adduser -u 1000 -S telegramarr -G telegramarr

# Create necessary directories with correct permissions
RUN mkdir -p /app/data /app/temp /app/movies /app/tvshows && \
    chown -R telegramarr:telegramarr /app && \
    chmod 755 /app/data /app/temp /app/movies /app/tvshows /app/telegramarr

# Make binary executable
RUN chmod +x /app/telegramarr

# Switch to non-root user
USER telegramarr

# Expose port for the application
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/ || exit 1

# Use tini as entrypoint to handle signals properly
ENTRYPOINT ["/sbin/tini", "--"]

# Default command - runs the application
CMD ["/app/telegramarr", "-config", "/app/config.yaml"]

# ============================================
# Build and run instructions:
# ============================================
# 1. Build Docker image (includes build process):
#    docker build -f Dockerfile.dev -t telegramarr:dev .
#
# 2. Run container for testing:
#    docker run -d \
#      --name telegramarr-dev \
#      -p 8080:8080 \
#      -v $(pwd)/config.yaml:/app/config.yaml:ro \
#      -v $(pwd)/data:/app/data \
#      -e TZ=UTC \
#      telegramarr:dev
#
# 3. View logs:
#    docker logs -f telegramarr-dev
#
# 4. Access:
#    - Frontend: http://localhost:8080
#    - API: http://localhost:8080/api/*
#    - Webhooks: http://localhost:8080/api/webhooks/radarr
#
# 5. Stop and remove:
#    docker stop telegramarr-dev && docker rm telegramarr-dev
#
# 6. Rebuild (without cache):
#    docker build -f Dockerfile.dev --no-cache -t telegramarr:dev .
#
# ============================================
# Notes:
# ============================================
# - Image includes all build tools (Go 1.25, Node.js, build-essential)
# - Larger image size (~800MB-1GB) due to build tools
# - Useful for development and testing complete build process
# - Each docker build recompiles everything (slower than production)
# - Final binary and assets are built fresh in container
# - All build dependencies (Node.js, Go) included in final image
# - go.mod requires Go >= 1.25.0
#
# For production use, build with Dockerfile (pre-built artifacts)
# For development/testing, use this Dockerfile.dev
