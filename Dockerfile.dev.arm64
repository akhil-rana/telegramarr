# ARM64 Development Dockerfile - builds and runs everything in container
# Alpine-based, minimal, native ARM64 Go build
# Note: RAR tools not available for ARM64

FROM arm64v8/golang:1.25-alpine AS base

# Install build dependencies (minimal)
RUN apk add --no-cache \
    git \
    make \
    gcc \
    musl-dev \
    curl \
    tar \
    nodejs \
    npm \
    p7zip \
    ca-certificates \
    tzdata \
    tini \
    libc6-compat

WORKDIR /app

# Copy entire source code
COPY . .

# Build React frontend
RUN echo "Building React frontend..." && \
    cd src/ui && \
    npm install && \
    npm run build && \
    cd /app && \
    echo "Frontend build complete"

# Build Go binary for ARM64 (go.mod is in src/ directory)
RUN echo "Building Go binary for ARM64..." && \
    cd src && \
    CGO_ENABLED=1 GOOS=linux GOARCH=arm64 go build \
    -ldflags="-s -w" \
    -o ../telegramarr \
    ./cmd/telegramarr && \
    cd /app && \
    echo "Go binary build complete"

# Verify builds
RUN echo "Verifying builds..." && \
    ls -lh telegramarr && \
    ls -la src/ui/dist/ && \
    [ -x ./telegramarr ] && echo "Binary is executable" && \
    echo "Build verification complete"

# Create non-root user for security
RUN addgroup -g 1000 -S telegramarr && \
    adduser -u 1000 -S telegramarr -G telegramarr

# Create necessary directories with correct permissions
RUN mkdir -p /app/data /app/temp /app/movies /app/tvshows && \
    chown -R telegramarr:telegramarr /app && \
    chmod 755 /app/data /app/temp /app/movies /app/tvshows /app/telegramarr

# Make binary executable
RUN chmod +x /app/telegramarr

# Switch to non-root user
USER telegramarr

# Expose port for the application
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/ || exit 1

# Use tini as entrypoint to handle signals properly
ENTRYPOINT ["/sbin/tini", "--"]

# Default command - runs the application
CMD ["/app/telegramarr", "-config", "/app/config.yaml"]

# ============================================
# Build and run instructions:
# ============================================
# 1. Build Docker image (includes full build):
#    docker build -f Dockerfile.dev.arm64 -t telegramarr:dev-arm64 .
#
# 2. Run container for testing:
#    docker run -d \
#      --name telegramarr-dev-arm64 \
#      -p 8080:8080 \
#      -v $(pwd)/config.yaml:/app/config.yaml:ro \
#      -v $(pwd)/data:/app/data \
#      -e TZ=UTC \
#      telegramarr:dev-arm64
#
# 3. View logs:
#    docker logs -f telegramarr-dev-arm64
#
# ============================================
# Notes:
# ============================================
# - ARM64 (aarch64) Alpine-based image (minimal)
# - Go binary: Compiled natively for ARM64 (native execution)
# - 7z: From p7zip package for alternative compression
# - Go 1.25 (required by go.mod)
# - Image size: ~800MB-1GB (with build tools)
# - Build time: ~15-20 minutes on ARM64 system
# - RAR tools: NOT included (use x86-64 container if RAR needed)
#
# Cross-compile from x86 with buildx:
#   docker buildx build --platform linux/arm64 -f Dockerfile.dev.arm64 -t telegramarr:dev-arm64 .
